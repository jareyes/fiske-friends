<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>{{subject}}</title>
</head>
{{!-- Email clients ignore most CSS, so the styles are inline and the layout is tables. --}}
<body style="margin:0;padding:0;background:#f3f5fc;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{preheader}}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f3f5fc;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
          <tr>
            <td style="background:#1f2559;border-radius:16px 16px 0 0;padding:18px 24px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="padding-right:12px;vertical-align:middle;">
                    <a href="{{base_url}}"><img src="{{logo_url}}" width="44" height="44" alt="" style="display:block;border:0;"></a>
                  </td>
                  <td style="vertical-align:middle;font-family:'Trebuchet MS','Arial Rounded MT Bold',Arial,sans-serif;">
                    <a href="{{base_url}}" style="color:#ffffff;text-decoration:none;font-size:22px;font-weight:bold;line-height:1.1;">Resolve to Read</a><br>
                    <span style="color:#c9d2ff;font-size:13px;font-weight:bold;">Friends of the Fiske Free Library</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="background:#ffffff;padding:28px 24px 24px;border-radius:0 0 16px 16px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#1c1f3f;">
              {{{body}}}
            </td>
          </tr>
          <tr>
            <td style="padding:18px 24px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#585d80;text-align:center;">
              Questions? Just reply to this email, or ask at the library desk.<br>
              Resolve to Read is the Friends of the Fiske Free Library's read-a-thon, {{date_range}}.<br>
              {{library_address}}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
