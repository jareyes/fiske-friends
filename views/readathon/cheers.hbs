<header class="ra-page-head">
  <h1 class="ra-h1">People cheering for {{reader.name}}</h1>
  <p class="ra-lede-dark">{{#if cheers.count}}{{cheers.count}} {{#if (eq cheers.count 1)}}cheer{{else}}cheers{{/if}}, {{cheers.total}} for the library!{{else}}No cheers yet. Share your link with family!{{/if}}</p>
</header>

<section class="ra-card ra-share" aria-labelledby="share-title">
  <h2 id="share-title" class="ra-h2">Your cheer link</h2>
  <p>Send it to grandparents, aunts, uncles, and friends. They can cheer you on with a gift for the library.</p>
  <div class="ra-share-row">
    <label class="ra-visually-hidden" for="share-url">Your cheer link</label>
    <input id="share-url" type="text" readonly value="{{share_url}}" data-share-url>
    <button class="ra-btn ra-btn-lamp" type="button" data-copy>Copy</button>
  </div>
  <p class="ra-muted" data-copy-status role="status"><a href="{{cheer_path}}">See what they'll see</a></p>
</section>

<section class="ra-card ra-reader-note" id="why" aria-labelledby="why-title">
  <h2 id="why-title" class="ra-h2">Why are you reading?</h2>
  <p>Tell the people you share your link with, in a sentence or two. It shows at the top of your cheer page.</p>
  {{#if message}}<p class="ra-flash" role="status">{{message}}</p>{{/if}}
  <form action="{{note_action}}" method="post">
    <label class="ra-field"><span class="ra-visually-hidden">Why you're reading</span><textarea name="note" rows="3" maxlength="{{note_max}}" placeholder="I want to read every Dog Man book! Every gift helps the library run summer reading.">{{note}}</textarea></label>
    <p class="ra-fine">Up to {{note_max}} characters. Skip last names, schools, and where you live: anyone with your link can see this.</p>
    <button class="ra-btn ra-btn-lamp" type="submit">Save</button>
  </form>
</section>

<section class="ra-card ra-cheer-books" id="books" aria-labelledby="cheer-books-title">
  <h2 id="cheer-books-title" class="ra-h2">Show what you're reading?</h2>
  {{#if books_message}}<p class="ra-flash" role="status">{{books_message}}</p>{{/if}}
  <p>{{#if books_shared}}Your cheer page shows the books you're reading and the ones you've finished.{{else}}Your cheer page can show the books you're reading and the ones you've finished. It's off for now.{{/if}}
    Private books never show. <a href="{{my_books_url}}">My books</a></p>
  <form action="{{sharing_action}}" method="post">
    <input type="hidden" name="back" value="cheers">
    <input type="hidden" name="cheer" value="{{#if books_shared}}0{{else}}1{{/if}}">
    <button class="ra-btn {{#if books_shared}}ra-btn-ghost{{else}}ra-btn-lamp{{/if}}" type="submit">{{#if books_shared}}Take them off my cheer page{{else}}Show my books{{/if}}</button>
  </form>
  {{#unless books_preview}}<p class="ra-fine">You don't have any books to show yet.</p>{{/unless}}
</section>

{{#if cheers.cheers}}
<ul class="ra-cheers">
  {{#each cheers.cheers}}
  <li>
    <span class="ra-cheer-star" aria-hidden="true"></span>
    <div><b>{{name}}</b>{{#if amount}} <span class="ra-muted">&middot; {{amount}}</span>{{/if}}{{#if message}}<p>&ldquo;{{message}}&rdquo;</p>{{/if}}</div>
  </li>
  {{/each}}
</ul>
{{/if}}

<p class="ra-fine">Cheers are optional and never change your prizes. Gifts support {{purpose}}.</p>
