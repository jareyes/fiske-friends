{{#block "head"}}{{> readathon-head}}{{/block}}
{{> readathon-nav}}

<header class="ra-page-head">
  <h1 class="ra-h1">Start a team</h1>
  <p class="ra-lede-dark">You'll get a link to invite your teammates.</p>
</header>

<form class="ra-form" action="{{base}}/teams/new" method="post" novalidate>
  {{> readathon-errors}}
  <fieldset class="ra-step">
    <legend><span class="ra-step-number">1</span> Team name</legend>
    <label class="ra-field"><span>Name</span><input name="name" type="text" maxlength="40" required value="{{form.name}}" placeholder="e.g. The Night Owls"></label>
    <p class="ra-help">Everyone can see team names, so keep it friendly.</p>
  </fieldset>

  <fieldset class="ra-step">
    <legend><span class="ra-step-number">2</span> Team goal for January</legend>
    <div class="ra-choices ra-choices-4">
      {{#each goals}}
      <label class="ra-choice ra-choice-tall"><input type="radio" name="goal_hours" value="{{hours}}"{{#if checked}} checked{{/if}}><span><b>{{hours}}</b><small>hours</small></span></label>
      {{/each}}
    </div>
    <p class="ra-help">Rule of thumb: about 5 hours per teammate. You'll all add up fast!</p>
  </fieldset>

  <fieldset class="ra-step">
    <legend><span class="ra-step-number">3</span> Who can join?</legend>
    <div class="ra-choices ra-choices-2">
      <label class="ra-choice ra-choice-tall"><input type="radio" name="is_open" value="0"{{#unless open_checked}} checked{{/unless}}><span><b>Invite only</b><small>People with your link</small></span></label>
      <label class="ra-choice ra-choice-tall"><input type="radio" name="is_open" value="1"{{#if open_checked}} checked{{/if}}><span><b>Anyone</b><small>From the teams page</small></span></label>
    </div>
  </fieldset>

  <fieldset class="ra-step">
    <legend><span class="ra-step-number">4</span> Who's on it from your home?</legend>
    <div class="ra-pick-readers">
      {{#each readers}}
      <label class="ra-pick-reader">
        <input type="checkbox" name="reader_ids" value="{{reader_id}}"{{#if checked}} checked{{/if}}>
        <span><span class="ra-avatar a{{color}}" aria-hidden="true">{{initial}}</span><b>{{name}}</b>{{#if current_team}}<small>leaves {{current_team}}</small>{{/if}}</span>
      </label>
      {{/each}}
    </div>
    <p class="ra-help">Each reader can be on one team. Kids can be on a different team from their grown-ups.</p>
  </fieldset>

  <button class="ra-btn ra-btn-lamp ra-btn-big ra-btn-block" type="submit">Make our team</button>
</form>
