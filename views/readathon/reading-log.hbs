<header class="ra-page-head">
  <a class="ra-small-link" href="{{reader_url}}">&larr; Back to {{reader.name}}'s page</a>
  <h1 class="ra-h1">{{reader.name}}'s reading log</h1>
</header>

{{#if message}}<p class="ra-flash" role="status">{{message}}</p>{{/if}}

<div class="ra-log-layout">
  <section class="ra-card ra-log-summary" aria-label="Summary">
    <ul class="ra-log-stats">
      <li><b>{{total_label}}</b><span>read in all</span></li>
      <li><b>{{stats.days_read}}</b><span>{{#if (eq stats.days_read 1)}}day{{else}}days{{/if}} read</span></li>
      <li><b>{{stats.best_streak}}</b><span>{{#if (eq stats.best_streak 1)}}day{{else}}days{{/if}} in a row, best</span></li>
    </ul>
    {{#unless (eq phase "before")}}<a class="ra-btn ra-btn-lamp ra-btn-block" href="{{reader_url}}/log">Add reading</a>{{/unless}}
  </section>

  <section class="ra-card ra-log-calendar" aria-labelledby="calendar-title">
    <h2 id="calendar-title" class="ra-h2">January</h2>
    <div class="ra-calendar" role="table" aria-label="Minutes read each day in January">
      <div class="ra-calendar-row ra-calendar-head" role="row" aria-hidden="true"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
      {{#each calendar}}
      <div class="ra-calendar-row" role="row">
        {{#each this}}
        {{#if outside}}<span class="ra-cal-day is-outside" role="cell" aria-hidden="true"></span>
        {{else}}<span class="ra-cal-day lv{{level}}{{#if is_today}} is-today{{/if}}{{#if future}} is-future{{/if}}" role="cell" title="{{label}}" aria-label="{{label}}">{{number}}</span>{{/if}}
        {{/each}}
      </div>
      {{/each}}
    </div>
    <p class="ra-fine">The more you read in a day, the brighter it shines.</p>
  </section>

  <div class="ra-log-weeks">
    {{#if weeks}}
    {{#each weeks}}
    <section class="ra-card ra-log-week" aria-label="{{label}}">
      <h2 class="ra-log-week-head"><span>{{#if is_this_week}}This week{{else}}{{label}}{{/if}}</span><span class="ra-log-week-total">{{total_label}}</span></h2>
      <ul class="ra-log-rows">
        {{#each entries}}
        <li>
          <a class="ra-log-row" href="{{@root.reader_url}}/entries/{{entry_id}}" aria-label="{{day_label}}, {{minutes}} minutes{{#if title}}, {{title}}{{/if}}. Change or remove">
            <span class="ra-log-what"><b>{{day_label}}</b>{{#if title}}<span class="ra-log-title">{{title}}{{#if format}} &middot; {{format}}{{/if}}</span>{{else}}{{#if format}}<span class="ra-log-title">{{format}}</span>{{/if}}{{/if}}</span>
            <span class="ra-log-min">{{minutes}} min</span>
            <span class="ra-log-edit" aria-hidden="true">Edit</span>
          </a>
        </li>
        {{/each}}
      </ul>
    </section>
    {{/each}}
    {{else}}
    <section class="ra-card ra-center"><p>Nothing yet. Any amount counts!</p></section>
    {{/if}}
  </div>

  <section class="ra-card ra-log-books" aria-labelledby="books-title">
    <h2 id="books-title" class="ra-h2">Books I read</h2>
    {{#if books}}
    <ul class="ra-books-read">
      {{#each books}}
      <li><span class="ra-log-what"><b>{{title}}</b><span class="ra-log-title">{{sessions}} {{#if sessions_plural}}times{{else}}time{{/if}}{{#if format}} &middot; {{format}}{{/if}} &middot; last read {{last_label}}</span></span><span class="ra-log-min">{{minutes_label}}</span></li>
      {{/each}}
    </ul>
    {{else}}
    <p class="ra-muted">Add a title when you log your reading and your books will show up here.</p>
    {{/if}}
  </section>
</div>
