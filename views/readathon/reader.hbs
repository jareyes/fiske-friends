<header class="ra-hello">
  <span class="ra-avatar a{{reader.color}}" aria-hidden="true">{{initial}}</span>
  <div>
    <h1 class="ra-h1">{{#if welcome}}Welcome, {{reader.name}}!{{else}}Hi, {{reader.name}}!{{/if}}</h1>
    <p class="ra-hello-links">{{#if several_readers}}<a class="ra-small-link" href="{{base}}/me">Not {{reader.name}}? Switch reader</a> &middot; {{/if}}<a class="ra-small-link" href="{{base}}/household">My household</a></p>
  </div>
</header>

{{#if get_ready}}
<section class="ra-today ra-get-ready" aria-labelledby="get-ready-title">
  <p class="ra-goal-label">Get ready</p>
  <h2 id="get-ready-title" class="ra-get-ready-count">{{get_ready.countdown}}</h2>
  <p class="ra-muted">The read-a-thon starts {{get_ready.start_label}}.{{#if get_ready.goal}} Your goal: <b>{{get_ready.goal.label}}</b>, {{get_ready.goal.hint}}.{{/if}}</p>
  <ol class="ra-checklist">
    {{#each get_ready.checklist}}
    <li class="{{#if done}}is-done{{/if}}">
      <a href="{{href}}">
        <span class="ra-check-mark" aria-hidden="true">{{#if done}}&check;{{/if}}</span>
        <span class="ra-check-text"><b>{{label}}</b><small>{{note}}</small></span>
        <span class="ra-visually-hidden">{{#if done}}(done){{/if}}</span>
      </a>
    </li>
    {{/each}}
  </ol>
  {{#if get_ready.next_event}}
  <a class="ra-get-ready-event" href="{{base}}/events/{{get_ready.next_event.slug}}">
    {{> readathon-date-badge get_ready.next_event.badge light=true}}
    <p><span class="ra-goal-label">Mark your calendar</span><b>{{get_ready.next_event.title}}</b><span>{{get_ready.next_event.time_label}}{{#if get_ready.next_event.location}} &middot; {{get_ready.next_event.location}}{{/if}}</span>{{#if get_ready.next_event.summary}}<small>{{get_ready.next_event.summary}}</small>{{/if}}</p>
  </a>
  {{/if}}
</section>
{{else}}
<section class="ra-today" aria-label="Today">
  <div class="ra-goal">
    <p class="ra-goal-label">{{#if progress.reached}}Goal reached!{{else}}My January goal{{/if}}</p>
    <p class="ra-goal-number"><b>{{progress.total_short}}</b> <span>of {{progress.goal_label}}</span></p>
    <div class="ra-meter ra-meter-lamp" role="img" aria-label="{{progress.percent}} percent of my January goal"><span style="width: {{progress.percent}}%"></span></div>
    <p class="ra-muted">{{progress.message}}</p>
    {{#if (eq phase "during")}}<p class="ra-today-plan{{#if today_plan.done}} is-done{{/if}}">{{#if today_plan.done}}<span aria-hidden="true">&check;</span> {{/if}}{{today_plan.text}}</p>{{/if}}
    {{#if (eq phase "during")}}
    <div class="ra-week" aria-label="This week">
      <ol class="ra-week-days">
        {{#each week}}
        <li class="{{#if read}}is-read{{/if}}{{#if is_today}} is-today{{/if}}{{#if future}} is-future{{/if}}{{#if outside}} is-outside{{/if}}" aria-label="{{label}}{{#unless future}}{{#unless outside}}{{#unless read}}: not yet{{/unless}}{{/unless}}{{/unless}}">
          <span class="ra-week-letter" aria-hidden="true">{{letter}}</span>
          <span class="ra-week-dot" aria-hidden="true">{{#if read}}&check;{{else}}{{number}}{{/if}}</span>
        </li>
        {{/each}}
      </ol>
      {{#if streak_note}}<p class="ra-week-streak">{{streak_note}}</p>{{/if}}
    </div>
    {{/if}}
  </div>
  {{#if (eq phase "during")}}
  <div class="ra-actions">
    <a class="ra-btn ra-btn-lamp ra-btn-big ra-btn-block" href="{{reader_url}}/timer"><span class="ra-btn-icon ra-icon-play" aria-hidden="true"></span>Start reading</a>
    <a class="ra-btn ra-btn-ghost ra-btn-block" href="{{reader_url}}/log">I already read</a>
  </div>
  {{else}}
  <p class="ra-muted">The read-a-thon is over. Thanks for reading! You can still add minutes you forgot.</p>
  <a class="ra-btn ra-btn-ghost ra-btn-block" href="{{reader_url}}/log">Add forgotten minutes</a>
  {{/if}}
</section>
{{/if}}

<section class="ra-card ra-reading-now" id="reading-now" aria-labelledby="reading-now-title">
  <div class="ra-recent-head">
    <h2 id="reading-now-title" class="ra-h2">What I'm reading</h2>
    <a class="ra-small-link" href="{{reader_url}}/reading-log#books">My books{{#if finished_count}} &middot; {{finished_count}} finished{{/if}}</a>
  </div>
  {{#if shelf_message}}<p class="ra-flash{{#if shelf_message.error}} ra-flash-bad{{/if}}" role="status">{{shelf_message.text}}</p>{{/if}}
  {{#if reading_now}}
  <ul class="ra-shelf">
    {{#each reading_now}}
    <li>
      <span class="ra-shelf-what"><b>{{title}}</b>{{#if author}}<span class="ra-muted">{{author}}</span>{{/if}}</span>
      {{#if minutes_label}}<span class="ra-shelf-time">{{minutes_label}}</span>{{/if}}
      <form action="{{@root.reader_url}}/books/{{shelf_id}}/finished" method="post">
        <input type="hidden" name="finished" value="1"><input type="hidden" name="back" value="reader">
        <button class="ra-btn ra-btn-ghost ra-btn-small" type="submit">Finished<span class="ra-visually-hidden"> {{title}}</span></button>
      </form>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="ra-muted">Add the books you're reading. The timer remembers them, so there's nothing to type when you're done.</p>
  {{/if}}
  {{> readathon-shelf-add back="reader" open=false}}
</section>

{{#unless get_ready}}
<section class="ra-card ra-recent" id="log" aria-labelledby="recent-title">
  <div class="ra-recent-head">
    <h2 id="recent-title" class="ra-h2">Recent reading</h2>
    {{#if entry_count}}<a class="ra-small-link" href="{{reader_url}}/reading-log">My reading log</a>{{/if}}
  </div>
  {{#if recent}}
  <ul class="ra-log-rows">
    {{#each recent}}
    <li>
      <a class="ra-log-row" href="{{@root.reader_url}}/entries/{{entry_id}}" aria-label="{{day_label}}, {{minutes}} minutes{{#if title}}, {{title}}{{/if}}. Change or remove">
        <span class="ra-log-what"><b>{{day_label}}</b>{{#if title}}<span class="ra-log-title">{{title}}</span>{{/if}}</span>
        <span class="ra-log-min">{{minutes}} min</span>
        <span class="ra-log-edit" aria-hidden="true">Edit</span>
      </a>
    </li>
    {{/each}}
  </ul>
  {{#if more_entries}}<a class="ra-btn ra-btn-ghost ra-btn-block" href="{{reader_url}}/reading-log">See all {{entry_count}} entries, your calendar and books</a>{{/if}}
  {{else}}
  <p class="ra-muted">Nothing yet. Any amount counts!</p>
  {{/if}}
</section>
{{/unless}}

<section class="ra-tiles" aria-label="More">
  <a class="ra-tile" href="{{reader_url}}/bingo">
    <span class="ra-tile-icon ra-icon-grid" aria-hidden="true"></span>
    <strong>Bingo card</strong>
    <span>{{#if get_ready}}Have a look; squares open {{start_short}}{{else}}{{#if board.blackout}}Blackout!{{else}}{{#if board.bingos}}Bingo! You earned a pin{{else}}{{board.to_bingo}} more for a bingo{{/if}}{{/if}}{{/if}}</span>
  </a>
  <a class="ra-tile" href="{{reader_url}}/cheers">
    <span class="ra-tile-icon ra-icon-heart" aria-hidden="true"></span>
    <strong>Sponsors</strong>
    <span>{{#if cheers.count}}{{cheers.count}} so far, {{cheers.total}}{{else}}Raise money for the library{{/if}}</span>
  </a>
  <a class="ra-tile" href="{{base}}/books">
    <span class="ra-tile-icon ra-icon-book" aria-hidden="true"></span>
    <strong>Find a book</strong>
    <span>Lists for every reader</span>
  </a>
</section>

<section class="ra-my-teams" aria-labelledby="my-teams-title">
  <div class="ra-my-teams-head">
    <h2 id="my-teams-title" class="ra-h2"><span class="ra-my-teams-icon" aria-hidden="true"></span>{{#if teams}}My teams{{else}}Read with a team{{/if}}</h2>
    {{#if teams}}<a class="ra-small-link" href="{{base}}/teams">See all teams</a>{{/if}}
  </div>
  {{#if teams}}
  <p class="ra-my-teams-note">Everyone's minutes add up toward each team's goal.</p>
  {{#each teams}}
  <a class="ra-team-card" href="{{@root.base}}/teams/{{code}}">
    <span class="ra-team-card-top"><strong>{{name}}</strong><span class="ra-team-card-count">{{member_count}} {{#if (eq member_count 1)}}reader{{else}}readers{{/if}}</span></span>
    <span class="ra-meter ra-meter-sky" aria-hidden="true"><span style="width: {{percent}}%"></span></span>
    <span class="ra-muted">{{#if reached}}Team goal reached! {{total_hours}} of {{goal_label}}{{else}}{{total_hours}} of {{goal_label}} &middot; {{read_today}} of {{member_count}} read today{{/if}}</span>
  </a>
  {{/each}}
  {{else}}
  <div class="ra-team-card ra-team-card-empty">
    <span class="ra-muted">Coworkers, classmates, friends: reach a goal together, and earn a raffle entry when you do.</span>
    <a class="ra-btn ra-btn-ghost" href="{{base}}/teams">See teams</a>
  </div>
  {{/if}}
</section>

<section class="ra-card ra-prizes-card" aria-labelledby="prizes-title">
  <h2 id="prizes-title" class="ra-h2">My prizes</h2>
  <ul class="ra-prizes">
    <li class="{{#if prizes.pin.earned}}is-earned{{/if}}">
      <b>Enamel pin</b>
      <span>{{#if prizes.pin.picked_up}}Picked up. Enjoy!{{else}}{{#if prizes.pin.earned}}You earned it! Pick it up at the library desk.{{else}}Get any bingo on <a href="{{reader_url}}/bingo">your bingo card</a>.{{/if}}{{/if}}</span>
    </li>
    <li class="{{#if prizes.tote.earned}}is-earned{{/if}}">
      <b>Tote bag</b>
      <span>{{#if prizes.tote.picked_up}}Picked up. Enjoy!{{else}}{{#if prizes.tote.earned}}You earned it! Pick it up at the library desk.{{else}}Fill your whole bingo card.{{/if}}{{/if}}</span>
    </li>
    <li class="{{#if raffle.count}}is-earned{{/if}}">
      <b>Grand prize raffle{{#if raffle.count}}: {{raffle.count}} {{#if raffle.plural}}entries{{else}}entry{{/if}}{{/if}}</b>
      {{#if raffle.count}}
      <span>{{#each raffle.reasons}}{{this}}{{#unless @last}} &middot; {{/unless}}{{/each}}</span>
      {{else}}
      <span>Reach your goal for an entry, plus one more for each team you're on that reaches its goal.</span>
      {{/if}}
    </li>
  </ul>
</section>

<section class="ra-card ra-reading-list" aria-labelledby="reading-list-title">
  <h2 id="reading-list-title" class="ra-h2"><span aria-hidden="true">&#9733;</span> My reading list</h2>
  {{#if reading_list.books}}
  <ul>
    {{#each reading_list.books}}<li><span><b>{{title}}</b>{{#if author}} <span class="ra-muted">by {{author}}</span>{{/if}}</span>
      <form action="{{@root.reader_url}}/books" method="post">
        <input type="hidden" name="title" value="{{title}}"><input type="hidden" name="author" value="{{author}}"><input type="hidden" name="back" value="reader">
        <button class="ra-text-btn" type="submit">Start reading<span class="ra-visually-hidden"> {{title}}</span></button>
      </form></li>{{/each}}
  </ul>
  <a href="{{reading_list.url}}">{{#if reading_list.more}}See all {{reading_list.count}}{{else}}See my list{{/if}}</a>
  {{else}}
  <p class="ra-muted">Star books on the <a href="{{reading_list.browse_url}}">book lists</a> to save them for later.</p>
  {{/if}}
</section>

<details class="ra-details" id="change-goal"{{#if goal_error}} open{{/if}}>
  <summary>Change my goal</summary>
  <form class="ra-goal-form" action="{{reader_url}}/goal" method="post">
    {{#if goal_error}}<div class="ra-errors" role="alert">{{goal_error}}</div>{{/if}}
    {{> readathon-goal-choices goals=goals}}
    <button class="ra-btn ra-btn-ghost" type="submit">Save goal</button>
  </form>
</details>
