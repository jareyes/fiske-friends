<div class="admin">
  <p><a href="/{{mounts.planning}}/events">&larr; All events</a></p>
  <div class="admin-head">
    <h1>{{#if event}}Edit event{{else}}New event{{/if}}</h1>
    {{#if readathon_url}}<a href="{{readathon_url}}">See it on the read-a-thon site</a>{{/if}}
  </div>

  {{#if errors}}
  <div class="admin-errors" role="alert">
    <p><strong>Please fix:</strong></p>
    <ul>{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
  </div>
  {{/if}}

  <form class="admin-form" method="post" action="/{{mounts.planning}}/events/save">
    <input type="hidden" name="event_id" value="{{event.event_id}}">

    <fieldset>
      <legend>The event</legend>
      <label class="admin-field">
        <span>Title</span>
        <input type="text" name="title" maxlength="120" required value="{{form.title}}">
      </label>
      <label class="admin-field">
        <span>Summary <small>One or two sentences, shown in lists</small></span>
        <textarea name="summary" rows="2" maxlength="500">{{form.summary}}</textarea>
      </label>
      <label class="admin-field">
        <span>More details <small>Optional, shown on the event's own page</small></span>
        <textarea name="description" rows="5" maxlength="5000">{{form.description}}</textarea>
      </label>
    </fieldset>

    <fieldset>
      <legend>When</legend>
      <div class="admin-row">
        <label class="admin-field"><span>Date</span><input type="date" name="date" required value="{{form.date}}"></label>
        <label class="admin-field"><span>Starts</span><input type="time" name="start_time" required value="{{form.start_time}}"></label>
        <label class="admin-field"><span>Ends</span><input type="time" name="end_time" required value="{{form.end_time}}"></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Where</legend>
      <label class="admin-field">
        <span>Room or place</span>
        <input type="text" name="location" maxlength="120" value="{{form.location}}" placeholder="e.g. Sarah Gilmore Room">
      </label>
      <label class="admin-field">
        <span>Street address <small>Leave empty if it's at the library</small></span>
        <input type="text" name="address" maxlength="200" value="{{form.address}}" placeholder="e.g. 120 Broad Street, Claremont, NH">
      </label>
    </fieldset>

    <fieldset>
      <legend>Tags</legend>
      <p class="admin-help">Series put an event on that series' calendar, like the read-a-thon's. An event can be in more than one.</p>
      <div class="admin-checks">
        {{#each series}}<label><input type="checkbox" name="tags" value="{{tag_id}}"{{#if checked}} checked{{/if}}> {{name}}</label>{{/each}}
      </div>
      <label class="admin-field">
        <span>Add a new series <small>Optional, like "Summer Reading 2027"</small></span>
        <input type="text" name="new_series" maxlength="60" value="{{form.new_series}}">
      </label>
      <p class="admin-help">Who it's for</p>
      <div class="admin-checks">
        {{#each audiences}}<label><input type="checkbox" name="tags" value="{{tag_id}}"{{#if checked}} checked{{/if}}> {{name}}</label>{{/each}}
      </div>
    </fieldset>

    <fieldset>
      <legend>Read-a-thon bingo</legend>
      <label class="admin-field">
        <span>Bingo code <small>Optional. Shown at the event; people enter it to mark this event's bingo square</small></span>
        <input type="text" name="bingo_code" maxlength="20" value="{{form.bingo_code}}" placeholder="e.g. SILENT" autocapitalize="characters">
      </label>
      {{#if bingo_warning}}<p class="admin-warning">{{bingo_warning}}</p>{{/if}}
    </fieldset>

    <fieldset>
      <legend>Publishing</legend>
      <label class="admin-check-row"><input type="checkbox" name="is_published" value="1"{{#if form.is_published}} checked{{/if}}> Show this event on the website</label>
      <details class="admin-advanced"{{#if form.slug}}{{#unless event}} open{{/unless}}{{/if}}>
        <summary>Web address</summary>
        <label class="admin-field">
          <span>Address ending <small>Leave empty to make one from the date and title</small></span>
          <input type="text" name="slug" maxlength="80" value="{{form.slug}}" placeholder="2027-01-02-kickoff-open-house">
        </label>
      </details>
    </fieldset>

    <button class="admin-button" type="submit">{{#if event}}Save changes{{else}}Create event{{/if}}</button>
  </form>
</div>
