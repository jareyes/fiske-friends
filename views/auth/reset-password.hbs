<div class="admin admin-auth">
  <div class="admin-auth-card">
    <h1>Choose a new password</h1>
    {{#if expired}}
    <p class="admin-errors" role="alert">This reset link has expired, has already been used, or isn't right. Each link works once, for one day.</p>
    <p><a class="admin-button admin-button-block" href="/{{mounts.auth}}/forgot">Email me a new link</a></p>
    <p class="admin-auth-note"><a href="/{{mounts.auth}}/login">Back to sign in</a></p>
    {{else}}
    <p class="admin-help">Use at least {{min_password_length}} characters. A few words strung together is easy to remember and hard to guess.</p>
    {{#if message}}<p class="admin-errors" role="alert">{{message}}</p>{{/if}}
    <form class="admin-form" method="post" action="/{{mounts.auth}}/reset">
      <input type="hidden" name="token" value="{{token}}">
      <label class="admin-field">
        <span>New password</span>
        <input type="password" name="password1" required minlength="{{min_password_length}}" autocomplete="new-password" autofocus>
      </label>
      <label class="admin-field">
        <span>Type it again</span>
        <input type="password" name="password2" required minlength="{{min_password_length}}" autocomplete="new-password">
      </label>
      <button class="admin-button admin-button-block" type="submit">Save my new password</button>
    </form>
    {{/if}}
  </div>
</div>
