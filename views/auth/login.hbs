<div class="admin admin-auth">
  <div class="admin-auth-card">
    <h1>Sign in</h1>
    <p class="admin-help">For the Friends board.</p>

    {{#if password_updated}}<p class="admin-flash" role="status">Your password is updated. Sign in with the new one.</p>{{/if}}
    {{#if cookie_problem}}<p class="admin-warning" role="alert"><strong>Sign-in won't stick here.</strong> {{cookie_problem}}</p>{{/if}}
    {{#if error_message}}<p class="admin-errors" role="alert">{{error_message}}</p>{{/if}}

    <form class="admin-form" method="post" action="/{{mounts.auth}}/login">
      <input type="hidden" name="redirect_url" value="{{redirect_url}}">
      <label class="admin-field">
        <span>Email</span>
        <input type="email" name="email" required autocomplete="username" inputmode="email" value="{{email}}"{{#unless email}} autofocus{{/unless}}>
      </label>
      <label class="admin-field">
        <span>Password</span>
        <input type="password" name="password" required autocomplete="current-password"{{#if email}} autofocus{{/if}}>
      </label>
      <button class="admin-button admin-button-block" type="submit">Sign in</button>
    </form>

    <p class="admin-auth-note"><a href="/{{mounts.auth}}/forgot">Forgot your password?</a></p>
  </div>
</div>
