{
  app: {
    domain: "fiskefriends.org",
    mounts: {
      auth: "auth",
      donations: "donate",
      events: "events",
      members: "members",
      planning: "plan",
    },
    link_salt: "link-salt",
    password_salt: "password-salt",
    port: 3000,
    protocol: "https",
    timezone: "America/New_York",
  },
  session: {
    secret: null,
    resave: false,
    saveUninitialized: true,
    cookie: {
      secure: true,
	  sameSite: "strict",
	  domain: "fiskefriends.org",
    },
  },
  sqlite: {
    filepath: "var/fiskefriends.sqlite",
  },
  events: {
    adopt_a_zombie: {
      // Thrill the World dancers people can adopt, exactly as they should
      // appear on the page and in Stripe. If empty, donors can still write in
      // a name or sponsor the whole horde.
      zombies: [],
      suggested_usd: [10, 25, 50, 100],
      minimum_usd: 5,
    },
  },
  stripe: {
    secret_key: null,
    publishable_key: null,
  },
}