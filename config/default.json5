{
  app: {
    domain: "fiskefriends.org",
    mounts: {
      auth: "auth",
      donations: "donate",
      events: "event",
      members: "members",
      planning: "plan",
    },
    link_salt: "link-salt",
    password_salt: "password-salt",
    port: 3000,
    protocol: "https",
    timezone: "America/New_York",
  },
  session: {
    secret: null,
    resave: false,
    saveUninitialized: true,
    cookie: {
      secure: true,
	  sameSite: "strict",
	  domain: "fiskefriends.org",
    },
  },
  sqlite: {
    filepath: "var/fiskefriends.sqlite",
  },
  stripe: {
    secret_key: null,
    publishable_key: null,
  },
}