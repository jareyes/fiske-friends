{
  app: {
    domain: "fiskefriends.org",
    mounts: {
      auth: "auth",
      donations: "donate",
      events: "event",
      members: "members",
      planning: "plan",
      readathon: "readathon",
    },
    link_salt: "link-salt",
    password_salt: "password-salt",
    port: 3000,
    protocol: "https",
    timezone: "America/New_York",
  },
  readathon: {
    starts: "2027-01-01",
    ends: "2027-01-31",
    community_goal_minutes: 100000,
    // This read-a-thon's events are the main site's events with this series tag (see /plan/events)
    event_tag: "readathon-2027-01",
    // "Find it at the Fiske" links on the book lists: searches of the library's public catalog.
    // {title} is the book's main title and {author} the author's last name. null turns the links off.
    catalog: {
      search_url: "https://fiskefreenh.booksys.net/opac/fiskefreenh/index.html#search:ExpertSearch?view=Bibliographic&SortDescend=0&ST0=T&M0=c&SF0={title}&B1=A&ST1=N&M1=c&SF1={author}",
      // For a book with no author given
      title_search_url: "https://fiskefreenh.booksys.net/opac/fiskefreenh/index.html#search:ExpertSearch?view=Bibliographic&SortDescend=0&ST0=T&M0=c&SF0={title}",
    },
    // For map links and calendar files; events elsewhere have their own address
    library_address: "Fiske Free Library, 108 Broad Street, Claremont, NH 03743",
    // Shown on the privacy page for questions and requests to correct or remove information.
    // Leave null to point people to the Friends' website instead.
    contact_email: null,
    // Sign-in emails per address: at most one every few minutes, and a few a day. 0 turns a limit off.
    sign_in_email_limits: {
      minutes_between: 2,
      per_day: 5,
    },
    // Pre-filled on the sign-up form; families can change them
    default_city: "Claremont",
    default_state: "NH",
    // For demos only: pretend today is this date (YYYY-MM-DD). Leave null in production.
    today_override: null,
    // For demos only: show sign-in links on screen instead of emailing them.
    show_sign_in_links: false,
    // For demos only: skip the card and record pretend gifts.
    fake_payments: false,
    fundraising: {
      goal_usd: 5000,
      // A sponsor gives this much per hour the whole community reads, up to the cap
      match_per_hour_usd: 1,
      match_cap_usd: 1500,
    },
  },
  mail: {
    // Who emails come from. Use an address at the domain your SMTP service is set up to send for.
    from: "Resolve to Read <readathon@fiskefriends.org>",
    // Where replies go (the Friends' Gmail). null sends replies to the from address.
    reply_to: null,
    // Without an SMTP host nothing is sent: emails wait in the outbox at /plan/emails, so you can
    // read them. Set these at deploy time with SMTP_HOST, SMTP_PORT, SMTP_USER and SMTP_PASS
    // (see config/custom-environment-variables.json5).
    smtp: {
      host: null,
      port: 587,
      // true for port 465; 587 starts plain and upgrades to TLS
      secure: false,
      user: null,
      pass: null,
    },
  },
  session: {
    secret: null,
    resave: false,
    // Only save a session once there's something in it (a sign-in, a message), not for every visitor
    saveUninitialized: false,
    cookie: {
      secure: true,
      // "lax" keeps people signed in when they follow a link here from an email or text message
      sameSite: "lax",
      domain: "fiskefriends.org",
    },
  },
  sqlite: {
    filepath: "var/fiskefriends.sqlite",
  },
  stripe: {
    secret_key: null,
    publishable_key: null,
  },
}